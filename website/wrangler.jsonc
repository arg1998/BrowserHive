{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "browserhive-website",
  "compatibility_date": "2026-09-01",
  // Static site only: no Worker script runs, Cloudflare serves dist/ directly.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "browserhive.ai", "custom_domain": true }],
  "preview_urls": true,
  "workers_dev": true
}
