{
  "name": "@browserhive/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "sync": "bun scripts/sync-docs.ts",
    "build": "bun scripts/sync-docs.ts && astro build",
    "preview": "bun run build && wrangler dev",
    "check": "bun scripts/sync-docs.ts && astro check && biome ci . && bun test",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "bun test",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.3.3",
    "satori": "0.33.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.13",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3",
    "wrangler": "4.133.0"
  },
  "packageManager": "bun@1.4.2"
}
