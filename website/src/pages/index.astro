---
// Landing page. Every claim here comes from the README and docs; keep them in step.
import LogoMark from '../components/LogoMark.astro';
import Site from '../layouts/Site.astro';
import { latest } from '../lib/versions.ts';

const docs = latest.base;

const installs = [
  { id: 'bun', label: 'bun', cmd: 'bun add -g browserhive' },
  { id: 'npm', label: 'npm', cmd: 'npm i -g browserhive' },
  { id: 'pnpm', label: 'pnpm', cmd: 'pnpm add -g browserhive' },
];

const console_ = [
  {
    t: '14:02:11',
    tool: 'launch_session',
    arg: '{ slug: "research" }',
    res: 'research-a1b2c3d4',
    kind: 'ok',
  },
  {
    t: '14:02:12',
    tool: 'navigate',
    arg: '"https://app.example.com/login"',
    res: 'ok',
    kind: 'ok',
  },
  {
    t: '14:02:13',
    tool: 'vault_fill',
    arg: '{ entry_name: "Example" }',
    res: 'success · redacted',
    kind: 'vault',
  },
  { t: '14:02:15', tool: 'snapshot', arg: '{ session_id }', res: 'ok', kind: 'ok' },
  {
    t: '14:02:16',
    tool: 'request_attention',
    arg: '{ reason: "2FA code" }',
    res: 'waiting for you',
    kind: 'attn',
  },
  { t: '14:02:41', tool: 'click', arg: '{ selector: "#export" }', res: 'ok', kind: 'ok' },
];

const cells = [
  { name: 'research', state: 'live' },
  { name: 'billing', state: 'attn' },
  { name: 'crm-sync', state: 'live' },
  { name: 'qa-login', state: 'idle' },
  { name: 'scrape-02', state: 'live' },
];

const features = [
  {
    tag: '01',
    title: 'Isolated sessions',
    body: 'One Chromium process and context per session: separate cookies, storage, IndexedDB and service workers. In memory by default, persistent profiles on request.',
    href: `${docs}guide/quick-start/`,
    size: 'wide',
    art: 'cells',
  },
  {
    tag: '02',
    title: 'Logins the model never sees',
    body: 'The agent names a Bitwarden entry. BrowserHive checks origin, session and principal, types the credential and returns only a status.',
    href: `${docs}guide/vault/`,
    size: 'tall',
    art: 'vault',
  },
  {
    tag: '03',
    title: 'Human takeover',
    body: '`request_attention` blocks the agent while you drive its browser live, then resolves with a message back.',
    href: `${docs}guide/attention/`,
    art: 'attn',
  },
  {
    tag: '04',
    title: 'Stealth, honestly scoped',
    body: 'Full Chromium in new-headless mode with Patchright, automation flags removed and a user agent derived from your real host. The limits are documented.',
    href: `${docs}guide/stealth/`,
    art: 'stealth',
  },
  {
    tag: '05',
    title: 'Audit trail and trace replay',
    body: 'Every tool call, navigation, vault access and blocked URL lands in SQLite. Replay any session in the built-in Trace Viewer.',
    href: `${docs}guide/dashboard/`,
    size: 'full',
    art: 'audit',
  },
];

const extras = [
  { title: 'One port', body: 'MCP, REST, WebSocket and dashboard share 127.0.0.1:9876.' },
  { title: 'OpenTelemetry', body: 'Opt-in OTLP traces, metrics and logs to any collector.' },
  {
    title: 'Guardrails',
    body: 'URL blocklist with hot reload, launch-argument deny-list, per-session ownership.',
  },
  {
    title: 'Operator dashboard',
    body: 'Sessions with live view, attention queue, vault log, logs and effective config.',
  },
];

const clients = [
  {
    id: 'claude-code',
    label: 'Claude Code',
    lang: 'bash',
    code: 'claude mcp add --transport http browserhive http://127.0.0.1:9876/mcp',
  },
  {
    id: 'json',
    label: 'Cursor · VS Code · any client',
    lang: 'json',
    code: `{
  "mcpServers": {
    "browserhive": {
      "type": "http",
      "url": "http://127.0.0.1:9876/mcp"
    }
  }
}`,
  },
  {
    id: 'stdio',
    label: 'stdio',
    lang: 'json',
    code: `{
  "mcpServers": {
    "browserhive": {
      "command": "browserhive",
      "args": ["--transport", "stdio"]
    }
  }
}`,
  },
];

/** Minimal JSON/shell highlighting without shipping a highlighter. */
function highlight(code: string, lang: string): string {
  const esc = code.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  if (lang === 'json') {
    return esc
      .replace(/("[^"]*")(\s*:)/g, '<span class="k">$1</span>$2')
      .replace(/(:\s*|\[|,\s*)("[^"]*")/g, '$1<span class="s">$2</span>');
  }
  return esc
    .replace(/^(\w+)/, '<span class="c">$1</span>')
    .replace(/(--[\w-]+)/g, '<span class="f">$1</span>')
    .replace(/(https?:\/\/\S+)/g, '<span class="s">$1</span>');
}
---

<Site
  title="BrowserHive · Browser sessions for AI agents"
  description="BrowserHive is a local MCP server that gives any agent isolated, stealthy Chromium sessions, logins through your password manager, human takeover and a replayable audit trail."
>
  <!-- ============ HERO ============ -->
