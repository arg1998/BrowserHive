---
// Right-hand page panel: reading progress, the table of contents on a rail with a sliding honey
// marker, and page actions (copy as Markdown, raw Markdown, edit, report).
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';
import TableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
import { markdownHref } from '../lib/docs-urls.ts';

const { toc, entry } = Astro.locals.starlightRoute;
const mdHref = markdownHref(entry.id);
const editUrl = typeof entry.data.editUrl === 'string' ? entry.data.editUrl : undefined;
const issueQuery = new URLSearchParams({
  title: 'docs: ' + entry.data.title,
  body: 'Page: https://browserhive.ai' + Astro.url.pathname + '\n\n',
});
const issueUrl = 'https://github.com/arg1998/BrowserHive/issues/new?' + issueQuery.toString();
---

{
  toc && (
    <>
      <div class="lg:sl-hidden">
        <MobileTableOfContents />
      </div>
      <div class="right-sidebar-panel sl-hidden lg:sl-block">
        <div class="sl-container hive-toc">
          <div class="toc-head">
            <span class="toc-label">On this page</span>
            <span class="progress" aria-hidden="true">
              <span class="progress-num" data-progress-num>0%</span>
            </span>
          </div>
          <div class="progress-bar" aria-hidden="true">
            <span data-progress-bar />
          </div>
          <div class="toc-rail" data-toc-rail>
            <span class="toc-marker" data-toc-marker aria-hidden="true" />
            <TableOfContents />
          </div>
          <div class="actions">
            <button type="button" class="action" data-copy-md={mdHref}>
              <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.5" /><path d="M3.5 10.5h-.5A1.5 1.5 0 0 1 1.5 9V3A1.5 1.5 0 0 1 3 1.5h6A1.5 1.5 0 0 1 10.5 3v.5" /></svg>
              <span data-copy-label>Copy page as Markdown</span>
            </button>
            <a class="action" href={mdHref}>
              <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="3.5" width="13" height="9" rx="1.5" /><path d="M4 10V6l1.75 2L7.5 6v4M10.5 6v4m0 0L9 8.5m1.5 1.5L12 8.5" /></svg>
              View as Markdown
            </a>
            {editUrl && (
              <a class="action" href={editUrl}>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.5 2.5l3 3L6 13H3v-3z" /></svg>
                Edit this page
              </a>
            )}
            <a class="action" href={issueUrl}>
              <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" /><path d="M8 4.75v3.75M8 11h.01" /></svg>
              Report an issue
            </a>
            <a class="action top" href="#_top">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" /></svg>
              Back to top
            </a>
          </div>
        </div>
      </div>
    </>
  )
}

<script>
  const rail = document.querySelector<HTMLElement>('[data-toc-rail]');
  const marker = document.querySelector<HTMLElement>('[data-toc-marker]');
  const bar = document.querySelector<HTMLElement>('[data-progress-bar]');
  const num = document.querySelector<HTMLElement>('[data-progress-num]');

  function placeMarker(): void {
    if (!rail || !marker) return;
    const current = rail.querySelector<HTMLElement>('a[aria-current="true"]');
    if (!current) {
      marker.style.opacity = '0';
      return;
    }
    const top = current.getBoundingClientRect().top - rail.getBoundingClientRect().top;
    marker.style.opacity = '1';
    marker.style.transform = `translateY(${top}px)`;
    marker.style.height = `${current.offsetHeight}px`;
    // Keep the active item visible when the list is taller than the panel.
    const panel = rail.closest<HTMLElement>('.right-sidebar');
    if (panel && panel.scrollHeight > panel.clientHeight) {
      const r = current.getBoundingClientRect();
      const p = panel.getBoundingClientRect();
      if (r.top < p.top + 80) panel.scrollTop -= p.top + 80 - r.top;
      else if (r.bottom > p.bottom - 40) panel.scrollTop += r.bottom - (p.bottom - 40);
    }
  }

  if (rail) {
    new MutationObserver(placeMarker).observe(rail, {
      subtree: true,
      attributes: true,
      attributeFilter: ['aria-current'],
    });
    window.addEventListener('resize', placeMarker);
  }

  let ticking = false;
  function updateProgress(): void {
    ticking = false;
    const doc = document.documentElement;
    const max = doc.scrollHeight - window.innerHeight;
    const pct = max > 0 ? Math.min(100, Math.max(0, Math.round((window.scrollY / max) * 100))) : 100;
    if (bar) bar.style.transform = `scaleX(${pct / 100})`;
    if (num) num.textContent = `${pct}%`;
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateProgress);
      }
    },
    { passive: true },
  );
  updateProgress();

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-md]')) {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector<HTMLElement>('[data-copy-label]');
      const original = label?.textContent ?? '';
      try {
        const res = await fetch(btn.dataset['copyMd'] ?? '');
        await navigator.clipboard.writeText(await res.text());
        if (label) label.textContent = 'Copied to clipboard';
        btn.dataset['state'] = 'done';
      } catch {
        if (label) label.textContent = 'Copy failed';
      }
      setTimeout(() => {
        if (label) label.textContent = original;
        delete btn.dataset['state'];
      }, 1800);
    });
  }
</script>

<style>
  .right-sidebar-panel {
    padding: 1.75rem var(--sl-sidebar-pad-x) 2rem;
  }
  .sl-container {
    width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
  }
  @media (min-width: 72rem) {
    .sl-container {
      max-width: calc(
        ((100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 * var(--sl-sidebar-pad-x)) * 0.25)
      );
    }
  }
  .toc-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .toc-label,
  .progress-num {
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--hive-dim);
  }
  .progress-num {
    font-variant-numeric: tabular-nums;
    color: var(--hive-honey-text);
    letter-spacing: 0.02em;
  }
  .progress-bar {
    position: relative;
    height: 2px;
    margin: 0.625rem 0 0.875rem;
    border-radius: 2px;
    background: var(--hive-line);
    overflow: hidden;
  }
  .progress-bar span {
    position: absolute;
    inset: 0;
    transform-origin: left;
    transform: scaleX(0);
    background: linear-gradient(90deg, var(--hive-blue), var(--hive-honey));
    transition: transform 0.12s linear;
  }
  .toc-rail {
    position: relative;
    padding-left: 0.875rem;
  }
  .toc-rail::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--hive-line-strong);
  }
  .toc-marker {
    position: absolute;
    left: -1px;
    top: 0;
    width: 3px;
    height: 1.5rem;
    border-radius: 3px;
    background: var(--hive-honey);
    box-shadow: 0 0 12px var(--hive-honey);
    opacity: 0;
    transition:
      transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
      height 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.2s;
  }
  .toc-rail :global(h2) {
    /* The panel prints its own label. */
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .toc-rail :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc-rail :global(ul ul) {
    padding-left: 0.75rem;
  }
  .toc-rail :global(a) {
    display: block;
    padding: 0.3rem 0.25rem 0.3rem 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--hive-muted);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 0.15s;
  }
  .toc-rail :global(ul ul a) {
    font-size: 0.78125rem;
    color: var(--hive-dim);
  }
  .toc-rail :global(a:hover) {
    color: var(--sl-color-white);
  }
  .toc-rail :global(a[aria-current='true']) {
    color: var(--sl-color-white);
    font-weight: 550;
  }
  .actions {
    display: grid;
    gap: 0.125rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hive-line);
  }
  .action {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    padding: 0.375rem 0.5rem;
    margin-left: -0.5rem;
    border: 0;
    border-radius: 0.5rem;
    background: none;
    font: inherit;
    font-size: 0.8125rem;
    text-align: left;
    color: var(--hive-muted);
    text-decoration: none;
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
  }
  .action:hover {
    color: var(--sl-color-white);
    background: var(--hive-bg-3);
  }
  .action svg {
    flex: none;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .action[data-state='done'] {
    color: var(--hive-green);
  }
  @media (prefers-reduced-motion: reduce) {
    .toc-marker,
    .progress-bar span {
      transition: none;
    }
  }
</style>
