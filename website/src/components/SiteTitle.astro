---
// Docs header brand: mark, wordmark, a /docs tag and the version switcher.
import { getCollection } from 'astro:content';
import { latest, switchVersionHref, versionOf, versions } from '../lib/versions.ts';
import LogoMark from './LogoMark.astro';

const { entry } = Astro.locals.starlightRoute;
const current = versionOf(entry.id);
const ids = new Set((await getCollection('docs')).map((e) => e.id));
const pathname = Astro.url.pathname;
---

<div class="brand">
  <a href="/" class="wordmark" aria-label="BrowserHive home">
    <LogoMark size={26} />
    <span translate="no">BrowserHive</span>
  </a>
  <a href={latest.base} class="docs-tag">docs</a>
  <details class="version-switch">
    <summary aria-label={`Docs version ${current.label}. Switch version`}>
      <span class="dot" data-latest={current.latest ? '' : undefined}></span>
      {current.label}
      <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </summary>
    <div class="menu" role="menu">
      <p class="menu-label">Documentation version</p>
      {
        versions.map((v) => (
          <a
            role="menuitem"
            href={switchVersionHref(pathname, v, ids)}
            aria-current={v.label === current.label ? 'true' : undefined}
          >
            <span class="v">{v.label}.x</span>
            <span class="meta">{v.latest ? 'latest' : v.version}</span>
          </a>
        ))
      }
      <a class="changelog" href="https://github.com/arg1998/BrowserHive/releases">
        Release notes
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2h6v6M10 2 3 9" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
      </a>
    </div>
  </details>
</div>

<script>
  // Close the version menu on outside click or Escape.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('.version-switch')) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--sl-color-white);
    font-weight: 650;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark :global(.logo-mark) {
    filter: drop-shadow(0 0 10px rgb(59 122 240 / 0.45));
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .wordmark:hover :global(.logo-mark) {
    transform: rotate(60deg);
  }
  .docs-tag {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--hive-muted);
    text-decoration: none;
    padding: 0.125rem 0.4rem;
    border-radius: 0.375rem;
    border: 1px dashed var(--hive-line-strong);
  }
  .docs-tag:hover {
    color: var(--sl-color-white);
    border-style: solid;
  }
  .version-switch {
    position: relative;
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-gray-2);
    padding: 0.2rem 0.45rem 0.2rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--hive-line-strong);
    background: var(--hive-bg-3);
    user-select: none;
    transition: border-color 0.15s, color 0.15s;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover,
  .version-switch[open] summary {
    color: var(--sl-color-white);
    border-color: var(--hive-honey);
  }
  summary svg {
    transition: transform 0.2s;
  }
  .version-switch[open] summary svg {
    transform: rotate(180deg);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hive-dim);
  }
  .dot[data-latest] {
    background: var(--hive-green);
    box-shadow: 0 0 8px var(--hive-green);
  }
  .menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 13rem;
    padding: 0.375rem;
    border-radius: 0.75rem;
    border: 1px solid var(--hive-line-strong);
    background: var(--hive-bg-2);
    box-shadow: 0 20px 50px -12px rgb(0 0 0 / 0.5);
    z-index: 100;
    animation: pop 0.14s ease-out;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
  }
  .menu-label {
    margin: 0;
    padding: 0.375rem 0.5rem 0.25rem;
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--hive-dim);
  }
  .menu a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 0.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
  }
  .menu a:hover {
    background: var(--hive-bg-4);
    color: var(--sl-color-white);
  }
  .menu a[aria-current] {
    color: var(--sl-color-white);
    background: var(--hive-honey-soft);
  }
  .menu .v {
    font-family: var(--sl-font-mono);
    font-weight: 600;
  }
  .menu .meta {
    font-size: 0.75rem;
    color: var(--hive-muted);
  }
  .menu a[aria-current] .meta {
    color: var(--hive-honey-text);
  }
  .menu .changelog {
    margin-top: 0.25rem;
    border-top: 1px solid var(--hive-line);
    border-radius: 0 0 0.5rem 0.5rem;
    font-size: 0.8125rem;
    color: var(--hive-muted);
  }
  @media (max-width: 30rem) {
    .docs-tag {
      display: none;
    }
  }
</style>
