---
// Page heading: section eyebrow, title and a meta row. The description stays in <meta> only,
// because it repeats the first paragraph.
/** Starlight's page title id, which its table of contents links to. */
const PAGE_TITLE_ID = '_top';

import { readingMinutes } from '../lib/docs-urls.ts';
import { versionOf } from '../lib/versions.ts';

const { entry, sidebar, lastUpdated } = Astro.locals.starlightRoute;
const version = versionOf(entry.id);

type Entry = (typeof sidebar)[number];
function sectionOf(entries: Entry[]): string | undefined {
  for (const e of entries) {
    if (e.type === 'group' && e.entries.some((c) => c.type === 'link' && c.isCurrent))
      return e.label;
  }
  return undefined;
}
const section = sectionOf(sidebar) ?? 'Documentation';
const minutes = readingMinutes(entry.body);
const updated = lastUpdated
  ? new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' }).format(lastUpdated)
  : undefined;
const generated =
  entry.data.editUrl === false && version.latest && entry.id.startsWith('docs/reference/');
---

<div class="page-head">
  <p class="eyebrow">
    <span class="hex" aria-hidden="true"></span>
    {section}
  </p>
  <h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
  <ul class="meta" aria-label="Page details">
    <li>
      <span class="chip">{version.label}{version.latest ? ' · latest' : ''}</span>
    </li>
    <li>{minutes} min read</li>
    {updated && <li>Updated {updated}</li>}
    {generated && <li class="gen">Generated from source</li>}
  </ul>
</div>

<style>
  .page-head {
    position: relative;
    padding-top: 1.25rem;
    padding-bottom: 0.25rem;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.875rem;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--hive-honey-text);
  }
  .hex {
    width: 0.625rem;
    height: 0.7rem;
    background: var(--hive-honey);
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    box-shadow: 0 0 12px var(--hive-honey);
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 1.4rem + 2.2vw, var(--sl-text-h1));
    line-height: 1.08;
    font-weight: 680;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 1.25rem;
    margin: 1.125rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--hive-dim);
  }
  .chip {
    color: var(--sl-color-gray-2);
    padding: 0.1rem 0.45rem;
    border-radius: 0.375rem;
    background: var(--hive-bg-3);
    border: 1px solid var(--hive-line);
  }
  .gen {
    color: var(--hive-muted);
  }
</style>
