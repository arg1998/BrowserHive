/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/llms*.txt
  Access-Control-Allow-Origin: *

/og/*
  Cache-Control: public, max-age=86400

# The signed site-pack registry (spec 13 §10.8). Pack files are content-addressed and never change.
/registry/v1/packs/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# keys.json, index.json and their .sig files: always revalidated. `:file` is one path segment, so
# this rule never reaches the pack files above.
/registry/v1/:file
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *
