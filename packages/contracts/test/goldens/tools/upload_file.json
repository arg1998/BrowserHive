{
  "name": "upload_file",
  "title": "Upload file",
  "description": "Set the files on a file <input> matched by selector. Every path MUST resolve under the server's uploads sandbox (<data-dir>/uploads/); out-of-tree paths fail with PATH_NOT_ALLOWED.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "selector": {
        "type": "string",
        "minLength": 1
      },
      "paths": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "timeout": {
        "default": 30000,
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "tab_id": {
        "type": "string"
      }
    },
    "required": ["session_id", "selector", "paths"]
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "selector": {
        "type": "string"
      },
      "ok": {
        "type": "boolean",
        "const": true
      }
    },
    "required": ["session_id", "selector", "ok"],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "since": "0.1.0"
}
