{
  "name": "list_tabs",
  "title": "List tabs",
  "description": "List every open tab: its tab_id, current URL, title, and whether it is active.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      }
    },
    "required": ["session_id"]
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "tab_id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        }
      },
      "required": ["tab_id", "url", "title", "active"],
      "additionalProperties": false
    }
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "since": "0.1.0"
}
