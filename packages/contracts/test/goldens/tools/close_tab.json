{
  "name": "close_tab",
  "title": "Close tab",
  "description": "Close a tab by id. If it was the active tab, another open tab becomes active.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "tab_id": {
        "type": "string"
      }
    },
    "required": ["session_id", "tab_id"]
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "tab_id": {
        "type": "string"
      },
      "closed": {
        "type": "boolean",
        "const": true
      }
    },
    "required": ["session_id", "tab_id", "closed"],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "since": "0.1.0"
}
