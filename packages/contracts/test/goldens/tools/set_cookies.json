{
  "name": "set_cookies",
  "title": "Set cookies",
  "description": "Add cookies to the session context. Each cookie needs name+value and either a url or a domain+path (Playwright semantics).",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "cookies": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": ["name", "value"],
          "additionalProperties": {}
        }
      }
    },
    "required": ["session_id", "cookies"]
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "added": {
        "type": "number"
      }
    },
    "required": ["added"],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "since": "0.1.0"
}
