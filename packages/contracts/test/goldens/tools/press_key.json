{
  "name": "press_key",
  "title": "Press key",
  "description": "Press a keyboard key. If a selector is given, focuses it first.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "key": {
        "type": "string",
        "minLength": 1
      },
      "selector": {
        "type": "string",
        "minLength": 1
      },
      "timeout": {
        "default": 30000,
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "tab_id": {
        "type": "string"
      }
    },
    "required": ["session_id", "key"]
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "key": {
        "type": "string"
      },
      "ok": {
        "type": "boolean",
        "const": true
      }
    },
    "required": ["session_id", "key", "ok"],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "since": "0.1.0"
}
