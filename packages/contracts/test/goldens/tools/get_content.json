{
  "name": "get_content",
  "title": "Get content",
  "description": "Return the current HTML content of a tab.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "tab_id": {
        "type": "string"
      }
    },
    "required": ["session_id"]
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "url": {
        "type": "string"
      },
      "html": {
        "type": "string"
      }
    },
    "required": ["session_id", "url", "html"],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "since": "0.1.0"
}
