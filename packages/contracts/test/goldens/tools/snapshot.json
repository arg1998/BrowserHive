{
  "name": "snapshot",
  "title": "Snapshot",
  "description": "Return the tab's ARIA accessibility tree (YAML) — purpose-built for LLM consumption.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "tab_id": {
        "type": "string"
      }
    },
    "required": ["session_id"]
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "url": {
        "type": "string"
      },
      "tree": {
        "type": "string"
      }
    },
    "required": ["session_id", "url", "tree"],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "since": "0.1.0"
}
