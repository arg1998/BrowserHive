{
  "name": "snapshot",
  "title": "Snapshot",
  "description": "Return the tab's ARIA accessibility tree (YAML) — purpose-built for LLM consumption. In a template session, text equal to a stored sign-in value that could be a secret (a cookie or site-data value) reads [sealed]; only that text is replaced, and URLs, numbers, language and time-zone names are shown as they are.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "tab_id": {
        "type": "string"
      }
    },
    "required": [
      "session_id"
    ]
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "url": {
        "type": "string"
      },
      "tree": {
        "type": "string"
      }
    },
    "required": [
      "session_id",
      "url",
      "tree"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "since": "0.1.0"
}
