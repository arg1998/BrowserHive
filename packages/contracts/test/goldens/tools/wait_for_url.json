{
  "name": "wait_for_url",
  "title": "Wait for URL",
  "description": "Wait until a tab's URL matches. `url` may be a string (exact/glob) or a { pattern, flags? } object compiled to a regular expression.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "url": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "flags": {
                "type": "string"
              }
            },
            "required": ["pattern"]
          }
        ]
      },
      "timeout": {
        "default": 30000,
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "tab_id": {
        "type": "string"
      }
    },
    "required": ["session_id", "url"]
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "url": {
        "type": "string"
      }
    },
    "required": ["session_id", "url"],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "since": "0.1.0"
}
