{
  "name": "drag_and_drop",
  "title": "Drag and drop",
  "description": "Drag the source element and drop it on the target element.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "source_selector": {
        "type": "string",
        "minLength": 1
      },
      "target_selector": {
        "type": "string",
        "minLength": 1
      },
      "timeout": {
        "default": 30000,
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "tab_id": {
        "type": "string"
      }
    },
    "required": ["session_id", "source_selector", "target_selector"]
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "ok": {
        "type": "boolean",
        "const": true
      }
    },
    "required": ["session_id", "ok"],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "since": "0.1.0"
}
