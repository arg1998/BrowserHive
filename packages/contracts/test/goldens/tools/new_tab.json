{
  "name": "new_tab",
  "title": "New tab",
  "description": "Open a new tab in the session and make it active. Optionally navigate it to a URL; only web URLs can be opened (http://, https://, about:blank and data:), and any other scheme fails with URL_SCHEME_NOT_ALLOWED without opening a tab. Returns the stable tab_id other tools accept via their optional tab_id argument. A url that answers with a download saves the file as navigate does and returns it under download (saved_to, suggested_name, size); the tab stays open on its blank page.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "url": {
        "type": "string"
      },
      "wait_until": {
        "default": "load",
        "type": "string",
        "enum": [
          "load",
          "domcontentloaded",
          "networkidle",
          "commit"
        ]
      },
      "timeout": {
        "default": 30000,
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "session_id"
    ]
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "tab_id": {
        "type": "string"
      },
      "url": {
        "type": "string"
      },
      "download": {
        "type": "object",
        "properties": {
          "saved_to": {
            "type": "string"
          },
          "suggested_name": {
            "type": "string"
          },
          "size": {
            "type": "number"
          }
        },
        "required": [
          "saved_to",
          "suggested_name",
          "size"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "session_id",
      "tab_id",
      "url"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "since": "0.1.0"
}
