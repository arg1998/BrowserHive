{
  "name": "navigate",
  "title": "Navigate",
  "description": "Navigate a tab to a URL (defaults to the active tab). The operator may maintain a URL blocklist; a blocked target fails with URL_BLOCKED and must not be retried.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "url": {
        "type": "string"
      },
      "wait_until": {
        "default": "load",
        "type": "string",
        "enum": ["load", "domcontentloaded", "networkidle", "commit"]
      },
      "timeout": {
        "default": 30000,
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "tab_id": {
        "type": "string"
      }
    },
    "required": ["session_id", "url"]
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "url": {
        "type": "string"
      },
      "status": {
        "type": ["number", "null"]
      }
    },
    "required": ["session_id", "url", "status"],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "since": "0.1.0"
}
